         return map;
     }
 
+    /**
+        The tempo changes of a clip's own sound, for a sound that doesn't keep one tempo (live
+        playing): the clip's "sourceTempoMap" property, pairs of numbers "beat bpm beat bpm...",
+        the beats counted from the start of the file and going up, the first pair at beat 0. Each
+        tempo holds until the next. A clip following the tempo then has the beats of its sound,
+        wherever they are in the file, played on the beats of the Edit.
+        Returns nothing if the clip has no such map (or one that can't be read).
+    */
+    std::vector<tempo::TempoChange> getSourceTempoChanges (const AudioClipBase& clip)
+    {
+        std::vector<tempo::TempoChange> changes;
+        const auto text = clip.state.getProperty (IDs::sourceTempoMap).toString();
+
+        if (text.isEmpty())
+            return changes;
+
+        juce::StringArray numbers;
+        numbers.addTokens (text, " ", {});
+        numbers.removeEmptyStrings();
+
+        for (int i = 0; i + 1 < numbers.size(); i += 2)
+        {
+            const auto beat = numbers[i].getDoubleValue();
+            const auto bpm = numbers[i + 1].getDoubleValue();
+            const bool inOrder = changes.empty() ? beat == 0.0
+                                                 : beat > changes.back().startBeat.inBeats();
+
+            if (! inOrder || bpm <= 0.0)
+                return {};
+
+            changes.push_back ({ BeatPosition::fromBeats (beat), bpm, 1.0f });
+        }
+
+        return changes;
+    }
+
